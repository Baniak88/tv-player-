<resources>
    <style name="BaseAppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#FF3D5E</item>
        <item name="android:colorControlActivated">#FF3D5E</item>
        <item name="android:textColorHighlight">#7A2A3B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0B0C0F</item>
        <item name="android:navigationBarColor">#0B0C0F</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#0B0C0F</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>
    <!-- Neutral graphite dialogs instead of the default grey Material ones. -->
    <style name="AppDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">#17191E</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:colorAccent">#FF3D5E</item>
        <item name="android:textColorPrimary">#F4F5F7</item>
        <item name="android:textColorSecondary">#A4A8B2</item>
    </style>
    <style name="AppTheme" parent="@style/BaseAppTheme" />
</resources>
